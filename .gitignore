# --- Data files (structure tracked via .gitkeep, contents excluded) ---
data/raw/*
data/processed/*
data/curated/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/curated/.gitkeep

# --- Large / generated files ---
*.csv
*.parquet
*.zip

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.ipynb_checkpoints/
merge.py

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Build ---
*.log
build/
dist/

# --- Desktop app (not part of the dissertation deliverable) ---
main.py